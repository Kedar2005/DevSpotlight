PORT=8000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRY=10h
REFRESH_TOKEN_EXPIRY=10d
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Password reset -------------------------------------------------------
# Frontend origin used to build the reset link.
FRONTEND_URL=http://localhost:5173
# Minutes a reset link stays valid (default 15).
PASSWORD_RESET_EXPIRY_MINUTES=15
# LOCAL TESTING ONLY: when no email provider is set, return the reset link in the API
# response so it can be tested. Ignored when NODE_ENV=production.
PASSWORD_RESET_DEV_MODE=true

# --- Email (optional) -----------------------------------------------------
# Leave blank to run without email. The app never claims an email was sent in that case;
# the reset link is printed in the backend console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DevSpotlight <no-reply@example.com>

# --- AI teammate recommendations (optional) -------------------------------
# Free key: https://aistudio.google.com/apikey . Server-side only; never expose to the client.
GEMINI_API_KEY=
# Any current Gemini text model; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
